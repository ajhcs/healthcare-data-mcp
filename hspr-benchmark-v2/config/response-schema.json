{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["question_id", "answer_status", "reporting_perimeter", "metric_label", "period", "units", "value", "primary_source_url", "exact_locator", "caveats", "aggregated_entities"],
  "properties": {
    "question_id": {"type": "string"},
    "answer_status": {"enum": ["reported", "unavailable_not_reported"]},
    "reporting_perimeter": {"type": "string"},
    "metric_label": {"type": "string"},
    "period": {"type": "string"},
    "units": {"type": "string"},
    "value": {"type": ["number", "null"]},
    "primary_source_url": {"type": "string"},
    "exact_locator": {"type": "string"},
    "caveats": {"type": "array", "items": {"type": "string"}},
    "aggregated_entities": {"type": "array", "items": {"type": "string"}},
    "clarification_needed": {"type": "boolean"},
    "closest_reported_subtotal": {
      "type": ["object", "null"],
      "properties": {"label":{"type":"string"},"value":{"type":"number"}},
      "required": ["label", "value"],
      "additionalProperties": false
    }
  }
}

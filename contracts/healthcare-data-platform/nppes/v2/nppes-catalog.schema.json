{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ushso.org/healthcare-data-platform/nppes/v2/nppes-catalog.schema.json",
  "title": "Healthcare Data Platform NPPES V2 catalog v2",
  "description": "One approved-public NPPES full-baseline source registration with explicit stream bounds.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "catalog_id", "sources"],
  "properties": {
    "schema_version": {"const": "hdp.nppes-catalog.v2", "type": "string"},
    "record_type": {"const": "nppes_catalog", "type": "string"},
    "catalog_id": {"type": "string", "pattern": "^catalog:[a-z0-9][a-z0-9._:-]*$"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"$ref": "#/$defs/source"}
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id", "title", "source_url", "release_locator", "change_mode",
        "rights_status", "enabled", "max_bytes", "max_chunks", "max_seconds", "max_chunk_bytes"
      ],
      "properties": {
        "source_id": {"const": "source:nppes:registry", "type": "string"},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "source_url": {"type": "string", "pattern": "^https://[A-Za-z0-9._:/-]+$"},
        "release_locator": {"type": "string", "pattern": "^https://[A-Za-z0-9._:/-]+$"},
        "change_mode": {"enum": ["release_metadata", "content_hash", "last_modified"]},
        "rights_status": {"enum": ["approved_public", "pending_review", "blocked"]},
        "enabled": {"type": "boolean"},
        "max_bytes": {"type": "integer", "minimum": 1, "maximum": 8589934592},
        "max_chunks": {"type": "integer", "minimum": 1, "maximum": 2000000},
        "max_seconds": {"type": "integer", "minimum": 1, "maximum": 14400},
        "max_chunk_bytes": {"type": "integer", "minimum": 1, "maximum": 8388608}
      }
    }
  }
}
